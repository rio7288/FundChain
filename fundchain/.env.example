# Use a Sepolia RPC URL from a provider such as Alchemy.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
# Optional override for the Node.js campaign API. Defaults to SEPOLIA_RPC_URL.
FUNDCHAIN_RPC_URL=
# Optional API port (defaults to 3001).
API_PORT=3001
# Use a TEST-ONLY wallet key with no real funds. Never commit .env.
DEPLOYER_PRIVATE_KEY=YOUR_TEST_WALLET_PRIVATE_KEY
